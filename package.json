{
  "name": "@dcodegroup/vue-mention",
  "description": "Mention popper for input and textarea",
  "version": "2.0.1",
  "author": "Dcode Group",
  "keywords": [
    "vue",
    "vuejs",
    "plugin",
    "mention",
    "popper"
  ],
  "license": "MIT",
  "main": "dist/vue-mention.umd.js",
  "module": "dist/vue-mention.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-mention.es.js",
      "require": "./dist/vue-mention.umd.js"
    }
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "build": "cross-env NODE_ENV=production vite build && tsc -d --emitDeclarationOnly && vue-typegen gen -s src -o dist",
    "prepublishOnly": "npm run lint && npm run build && npm run test",
    "lint": "eslint --ext .ts,.js,.vue src",
    "test": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcodegroup/vue-mention.git",
    "directory": "packages/vue-mention"
  },
  "bugs": {
    "url": "https://github.com/dcodegroup/vue-mention/issues"
  },
  "homepage": "https://github.com/dcodegroup/vue-mention#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "textarea-caret": "^3.1.0",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "floating-vue": "^2.0.0-beta.1"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/preset-env": "^7.9.0",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "@vitejs/plugin-vue": "^2.0.1",
    "@vue/eslint-config-standard": "^5.0.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "autoprefixer": "^9.7.5",
    "clean-css": "^4.1.8",
    "cross-env": "^7.0.2",
    "eslint": "^7.24.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-html": "^6.0.0",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^9.7.0",
    "floating-vue": "^2.0.0-beta.1",
    "typescript": "^5.7.3",
    "vite": "^2.7.10",
    "vue-typegen": "^0.1.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie > 0",
    "not ie_mob > 0"
  ],
  "files": [
    "dist"
  ]
}
